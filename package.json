{
  "name": "alkanes-ts",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental TypeScript SDK for Bitcoin alkanes contracts, compiled to WebAssembly with scriptc",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:built": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit && node compiler/check.mjs",
    "check:wasmi": "cargo run --quiet --release --manifest-path harness/Cargo.toml --bin wasmi-check --",
    "bench": "cargo run --quiet --release --manifest-path harness/Cargo.toml --bin bench --",
    "build:bench:rust": "node bench/build-rust.mjs",
    "build:bench:capped": "node bench/build-capped.mjs",
    "build:bench:capped-opt": "node bench/build-capped-optimization.mjs",
    "bench:capped-opt": "node bench/measure-capped-optimization.mjs",
    "test:runtime": "npm run build && npm run build:bench:capped && node integration/run.mjs",
    "bench:capped": "node integration/run.mjs --bench",
    "build:bench:examples": "node bench/build-examples.mjs",
    "test:examples": "npm run build && npm run build:bench:rust && npm run build:bench:capped && node integration/run.mjs --examples",
    "bench:examples": "node integration/run.mjs --examples --bench",
    "bench:speed": "node bench/measure-speed.mjs",
    "build:bench:isolate": "node bench/build-isolation.mjs",
    "bench:isolate": "cargo run --quiet --release --manifest-path harness/Cargo.toml --bin isolate --",
    "build:bench:optimize": "node bench/build-optimization.mjs",
    "bench:optimize": "cargo run --quiet --release --manifest-path harness/Cargo.toml --bin optimize --",
    "test:bench:optimize": "node --test test/bytes.test.mjs",
    "bench:sdk": "node bench/measure-sdk.mjs",
    "setup:native": "node scripts/native/setup.mjs",
    "build:native": "node scripts/build-native-counter.mjs",
    "test:native": "npm run build:native && ALKANES_NATIVE_TESTS=1 node --test test/native-counter.test.mjs",
    "bench:native": "node integration/run.mjs --native-counter --bench",
    "check:upstream-patch": "node scripts/native/check-upstream.mjs"
  },
  "devDependencies": {
    "@scriptc/runtime-wasm32-wasi": "0.4.0",
    "@scriptc/types": "0.4.0",
    "binaryen": "^125.0.0",
    "scriptc": "0.4.0",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "scriptc@0.4.0": true
  }
}
