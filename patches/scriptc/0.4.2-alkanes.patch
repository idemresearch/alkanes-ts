+import type { IrLibSection } from "../../ir/ir.js";
+
+/** Compiler-owned scalar Wasm lowering. No contract selectors, storage keys,
+ * or SDK policy live here. All u128 operands are immutable LE memory values. */
+export function emitWasmLibraryLeaves(lib: IrLibSection, wasi: boolean): string[] {
+  if (!wasi) return [];
+  const names = new Set(
+    (lib.callbacks ?? []).flatMap((c) =>
+      c.wasm?.intrinsic === undefined ? [] : [c.wasm.intrinsic],
+    ),
+  );
+  if (lib.wasmAbi === undefined && !(lib.callbacks ?? []).some((c) => c.wasm !== undefined))
+    return [];
+  const out: string[] = [
+    `declare double @scr_bit_ushr(double, double)
+define internal double @sc_wasm_to_u32(double %v) alwaysinline {
+entry:
+  %positive = fcmp oge double %v, 0.0
+  %bounded = fcmp olt double %v, 4294967296.0
+  %fast = and i1 %positive, %bounded
+  br i1 %fast, label %simple, label %fallback
+simple:
+  %integer = fptoui double %v to i32
+  %result = uitofp i32 %integer to double
+  ret double %result
+fallback:
+  %coerced = call double @scr_bit_ushr(double %v, double 0.0)
+  ret double %coerced
+}`,
+  ];
+  const def = (name: string, result: string, params: string, body: string): void => {
+    out.push(
+      `define internal ${result} @sc_wasm_intrinsic_${name.replaceAll(".", "_")}(${params}) alwaysinline {\nentry:\n${body}\n}`,
+    );
+  };
+  out.push(`declare i32 @llvm.wasm.memory.grow.i32(i32, i32)
+@sc_arena_next = internal global i32 0
+@sc_arena_end = internal global i32 0
+define i32 @__adapter_reserve(i32 %n) {
+entry:
+  %limit = icmp ugt i32 %n, 2147483600
+  br i1 %limit, label %bad, label %size
+size:
+  %plus = add i32 %n, 23
+  %aligned = and i32 %plus, -16
+  %next = load i32, ptr @sc_arena_next
+  %end = load i32, ptr @sc_arena_end
+  %avail = sub i32 %end, %next
+  %fits = icmp ule i32 %aligned, %avail
+  br i1 %fits, label %use, label %grow
+grow:
+  %rounded = add i32 %aligned, 65535
+  %pages = lshr i32 %rounded, 16
+  %old = call i32 @llvm.wasm.memory.grow.i32(i32 0, i32 %pages)
+  %failed = icmp eq i32 %old, -1
+  br i1 %failed, label %bad, label %grown
+grown:
+  %start = shl i32 %old, 16
+  %extent = shl i32 %pages, 16
+  %newend = add i32 %start, %extent
+  store i32 %newend, ptr @sc_arena_end
+  br label %use
+use:
+  %base = phi i32 [ %next, %size ], [ %start, %grown ]
+  %newnext = add i32 %base, %aligned
+  store i32 %newnext, ptr @sc_arena_next
+  %p = inttoptr i32 %base to ptr
+  store i32 %n, ptr %p, align 1
+  %data = add i32 %base, 4
+  ret i32 %data
+bad:
+  call void @llvm.trap()
+  unreachable
+}`);
+  out.push(`declare void @llvm.trap()`);
+  if (names.has("arena.alloc"))
+    def("arena.alloc", "i32", "i32 %n", "  %p = call i32 @__adapter_reserve(i32 %n)\n  ret i32 %p");
+  for (const bits of [8, 32]) {
+    if (names.has(`memory.load${bits}`))
+      def(
+        `memory.load${bits}`,
+        "i32",
+        "i32 %a",
+        `  %p = inttoptr i32 %a to ptr\n  %v = load i${bits}, ptr %p, align 1\n${bits === 8 ? "  %wide = zext i8 %v to i32\n  ret i32 %wide" : "  ret i32 %v"}`,
+      );
+    if (names.has(`memory.store${bits}`))
+      def(
+        `memory.store${bits}`,
+        "void",
+        "i32 %a, i32 %v",
+        `  %p = inttoptr i32 %a to ptr\n${bits === 8 ? "  %byte = trunc i32 %v to i8\n  store i8 %byte, ptr %p, align 1" : "  store i32 %v, ptr %p, align 1"}\n  ret void`,
+      );
+  }
+  out.push("declare void @llvm.memmove.p0.p0.i32(ptr, ptr, i32, i1 immarg)");
+  if (names.has("memory.fill")) {
+    out.push("declare void @llvm.memset.p0.i32(ptr, i8, i32, i1 immarg)");
+    def(
+      "memory.fill",
+      "void",
+      "i32 %a, i32 %v, i32 %n",
+      "  %p = inttoptr i32 %a to ptr\n  %b = trunc i32 %v to i8\n  call void @llvm.memset.p0.i32(ptr %p, i8 %b, i32 %n, i1 false)\n  ret void",
+    );
+  }
+  if (names.has("memory.equal"))
+    def(
+      "memory.equal",
+      "i32",
+      "i32 %a, i32 %b, i32 %n",
+      `  br label %loop
+loop:
+  %i = phi i32 [ 0, %entry ], [ %next, %match ]
+  %done = icmp eq i32 %i, %n
+  br i1 %done, label %yes, label %read
+read:
+  %aa = add i32 %a, %i
+  %ba = add i32 %b, %i
