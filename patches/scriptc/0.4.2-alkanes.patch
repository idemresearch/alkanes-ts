@@ -0,0 +1,20 @@
+/** Native Wasm leaves. Addresses are ToUint32 numbers in the library's own memory.
+ * Checked operations write 16 little-endian bytes and return 1 on overflow.
+ * They do not redefine JavaScript bigint arithmetic. */
+export const WASM_INTRINSICS: Record<string, [string[], string]> = {
+  "arena.alloc": [["u32"], "u32"],
+  "memory.load8": [["u32"], "u32"],
+  "memory.load32": [["u32"], "u32"],
+  "memory.store8": [["u32", "u32"], "void"],
+  "memory.store32": [["u32", "u32"], "void"],
+  "memory.fill": [["u32", "u32", "u32"], "void"],
+  "memory.equal": [["u32", "u32", "u32"], "u32"],
+  "memory.copy": [["u32", "u32", "u32"], "void"],
+  "bytes.copy": [["bytes"], "u32"],
+  "u128.add.checked": [["u32", "u32", "u32"], "u32"],
+  "u128.sub.checked": [["u32", "u32", "u32"], "u32"],
+  "u128.mul.checked": [["u32", "u32", "u32"], "u32"],
+  "u128.compare": [["u32", "u32"], "i32"],
+  "u128.fromNumber.checked": [["u32", "f64"], "u32"],
+  "u128.toNumber": [["u32"], "f64"],
+};
diff --git a/packages/compiler/src/library/wasm-intrinsics.test.ts b/packages/compiler/src/library/wasm-intrinsics.test.ts
new file mode 100644
index 0000000..202e337
--- /dev/null
+++ b/packages/compiler/src/library/wasm-intrinsics.test.ts
@@ -0,0 +1,90 @@
+import { mkdtempSync, writeFileSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { describe, expect, test } from "vitest";
+import { loadLibraryProfile } from "./library-profile.js";
+import { emitWasmLibraryLeaves } from "../backend/llvm/wasm-library.js";
+import type { IrLibSection } from "../ir/ir.js";
+
+function profile(callback: object, extra: object = {}) {
+  const directory = mkdtempSync(join(tmpdir(), "scriptc-wasm-profile-"));
+  try {
+    const path = join(directory, "profile.json");
+    writeFileSync(
+      path,
+      JSON.stringify({
+        profile_format: 1,
+        name: "test",
+        entry: "entry.ts",
+        emission: "llvm",
+        abi: {
+          prefix: "t_",
+          init_symbol: "t_init",
+          sink_register_symbol: "t_sink",
+          callback_register_symbol: "t_callback",
+        },
+        exports: [
+          { export: "execute", symbol: "t_execute", params: ["bytes"], returns: "f64" },
+          { export: "meta", symbol: "t_meta", params: [], returns: "bytes" },
+        ],
+        callbacks: [callback],
+        ...extra,
+      }),
+    );
+    return loadLibraryProfile(path);
+  } finally {
+    rmSync(directory, { recursive: true });
+  }
+}
+const add = {
+  name: "add",
+  params: ["u32", "u32", "u32"],
+  returns: "u32",
+  wasm: { intrinsic: "u128.add.checked" },
+};
+describe("Wasm native library opt-in", () => {
+  test("accepts exact checked arithmetic signatures and Alkanes entry layout", () => {
+    const result = profile(add, { wasm_abi: "alkanes-v1" });
+    expect(result.ok).toBe(true);
+    if (result.ok) expect(result.profile.callbacks[0]?.wasm?.intrinsic).toBe("u128.add.checked");
+  });
+  test("refuses typos, signature drift and mixed intrinsic/import bindings", () => {
+    for (const callback of [
+      { ...add, returns: "f64" },
+      { ...add, wasm: { intrinsic: "u128.add.wrapping" } },
+      { ...add, wasm: { intrinsic: "u128.add.checked", module: "env" } },
+      { ...add, wasm: { module: 'env"', name: "load" } },
+    ])
+      expect(profile(callback).ok).toBe(false);
+    expect(profile(add, { wasm_abi: "alkanes-v2" }).ok).toBe(false);
+    expect(
+      profile(add, {
+        exports: [{ export: "execute", symbol: "t_execute", params: [], returns: "f64" }],
+      }).ok,
+    ).toBe(true);
+    expect(
+      profile(add, {
+        wasm_abi: "alkanes-v1",
+        exports: [{ export: "execute", symbol: "t_execute", params: [], returns: "f64" }],
+      }).ok,
+    ).toBe(false);
+  });
+  test("ordinary libraries emit no native definitions", () => {
+    expect(emitWasmLibraryLeaves({ callbacks: [] } as unknown as IrLibSection, true)).toEqual([]);
+  });
+  test("uses unsigned LLVM carry/borrow and scalar limbs, with no SIMD or hidden SDK imports", () => {
+    const callbacks = ["add", "sub", "mul"].map((name, slot) => ({
+      name,
+      slot,
+      params: ["u32", "u32", "u32"],
+      returns: "u32",
+      unregisteredTrap: "",
+      wasm: { intrinsic: `u128.${name}.checked` },
+    }));
+    const llvm = emitWasmLibraryLeaves({ callbacks } as IrLibSection, true).join("\n");
+    expect(llvm).toContain("llvm.uadd.with.overflow.i128");
+    expect(llvm).toContain("llvm.usub.with.overflow.i128");
+    expect(llvm).toContain("mul i64");
+    expect(llvm).not.toMatch(/<\d+ x|__multi3|word\.c|wasm-import-module.*scriptc/);
+  });
+});
